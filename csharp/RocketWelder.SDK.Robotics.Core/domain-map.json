{
  "$schema": "https://modelingevolution.com/schemas/domain-map/v1",
  "repo": "rocket-welder-sdk",
  "project": "RocketWelder.SDK.Robotics.Core",
  "description": "Robotics core (Epic-021): DH FK/IK, presets, collision, step program; dissolved by FR-10.",
  "domain": "Robotic platform",
  "subdomain": "Robot motion",
  "boundedContext": "robot-motion",
  "layer": "engine",
  "status": "deprecated",
  "epic": "epics/epic-129-matrix/requirements.md#forward-kinematics-inventory-verified-2026-10-24-and-the-owner-ruling-on-the-sdk",
  "components": [
    {
      "name": "FK chain: modified-DH forward kinematics",
      "kind": "solver",
      "types": [
        "ForwardKinematics",
        "FkValidator",
        "RobotModel"
      ],
      "status": "deprecated",
      "epic": "epics/epic-129-matrix/requirements.md#forward-kinematics-inventory-verified-2026-10-24-and-the-owner-ruling-on-the-sdk",
      "description": "Forward-kinematics chain #4 of 7 (Craig modified DH); becomes the Drawing chain via a DH import.",
      "note": "No csproj outside its own tests references it."
    },
    {
      "name": "Inverse kinematics",
      "kind": "solver",
      "types": [
        "InverseKinematics",
        "IkFailureReason"
      ],
      "status": "deprecated",
      "epic": "epics/epic-129-matrix/design.md#moved-from-map-matrix",
      "description": "Replaced by Matrix DlsIk."
    },
    {
      "name": "Robot presets",
      "kind": "library",
      "types": [
        "RobotPresets"
      ],
      "status": "deprecated",
      "epic": "epics/epic-129-matrix/requirements.md#forward-kinematics-inventory-verified-2026-10-24-and-the-owner-ruling-on-the-sdk",
      "description": "Become library robot definitions."
    },
    {
      "name": "Collision primitives and simulated robot",
      "kind": "service",
      "types": [
        "CollisionDetector",
        "CollisionEnvironment",
        "CollisionPrimitive",
        "PrimitiveCollisionSource",
        "SimulatedRobot"
      ],
      "status": "deprecated",
      "epic": "epics/epic-129-matrix/design.md#moved-from-map-matrix",
      "description": "Deleted; Matrix spatial index and checks cover them."
    },
    {
      "name": "Step program",
      "kind": "library",
      "types": [
        "RobotProgram",
        "ProgramStep",
        "MoveLinStep",
        "MoveJointStep",
        "TeachingPointSet"
      ],
      "status": "deprecated",
      "epic": "epics/epic-129-matrix/requirements.md#forward-kinematics-inventory-verified-2026-10-24-and-the-owner-ruling-on-the-sdk",
      "description": "Parseable motion step list the weld path never used; goes with the package."
    }
  ],
  "dependsOn": [
    {
      "target": "RocketWelder.SDK.Abstractions",
      "pattern": "conformist"
    },
    {
      "target": "RocketWelder.SDK.Devices.Robot",
      "pattern": "conformist"
    },
    {
      "target": "ModelingEvolution.Drawing",
      "pattern": "conformist",
      "note": "CF + PL: Drawing's value types are the published language"
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RocketWelder.SDK.Vision</PackageId>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Description>Camera vision abstractions for the RocketWelder SDK (ICameraProjector, CameraIntrinsics, CameraProjector, ICameraViewLocator).</Description>
    <PackageTags>rocketwelder;vision;camera;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelingEvolution.Drawing" Version="1.9.8.75" />
    <ProjectReference Include="..\RocketWelder.SDK.Protocols\RocketWelder.SDK.Protocols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Perception handles keep internal ctors; the producer (video client) and the
         provider wrapper (Runtime) construct them. -->
    <InternalsVisibleTo Include="RocketWelder.SDK" />
    <InternalsVisibleTo Include="RocketWelder.SDK.Runtime" />
  </ItemGroup>

</Project>

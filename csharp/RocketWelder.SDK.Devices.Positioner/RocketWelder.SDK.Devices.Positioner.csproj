<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RocketWelder.SDK.Devices.Positioner</PackageId>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Description>Welding-positioner device family for the RocketWelder SDK (IPositioner, IPositionerAxis, PositionerAxisStatus). Contract only — no transport dependencies.</Description>
    <PackageTags>rocketwelder;devices;positioner;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelingEvolution.Drawing" Version="1.9.8.75" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWelder.SDK.Abstractions\RocketWelder.SDK.Abstractions.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RocketWelder.SDK.AdaptivePoints</PackageId>
    <Version>1.1.0</Version>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Description>Adaptive-points and adaptive-path host extensions for RocketWelder programs (IAdaptivePoint, IAdaptivePointService, AdaptResult, IAdaptivePath, IAdaptivePathService, TraverseReport, OffsetState, context extensions).</Description>
    <PackageTags>rocketwelder;adaptivepoints;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelingEvolution.Drawing" Version="1.9.8.75" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWelder.SDK.Runtime\RocketWelder.SDK.Runtime.csproj" />
    <ProjectReference Include="..\RocketWelder.SDK.Devices.Robot\RocketWelder.SDK.Devices.Robot.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RocketWelder.SDK.Server</PackageId>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Copyright>Copyright © ModelingEvolution 2024</Copyright>
    <Description>Server-side library for testing RocketWelder SDK containers. Simulates GStreamer by sending frames via DuplexChannel and reading AI results from sockets.</Description>
    <PackageTags>video;streaming;testing;zerobuffer;sharedmemory;gstreamer;simulation</PackageTags>
    <PackageProjectUrl>https://github.com/modelingevolution/rocket-welder-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated into the assembly by the SDK (GenerateAssemblyInfo, now enabled). The deleted
         AssemblyInfo.cs hardcoded AssemblyVersion 1.0.0.0 alongside GenerateAssemblyInfo=false,
         which pinned this dll at 1.0.0.0 regardless of the release version. -->
    <InternalsVisibleTo Include="RocketWelder.SDK.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWelder.SDK\RocketWelder.SDK.csproj" />
    <ProjectReference Include="..\RocketWelder.SDK.Protocols\RocketWelder.SDK.Protocols.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.11.0.5746" />
    <PackageReference Include="Emgu.CV.runtime.ubuntu-x64" Version="4.11.0.5746" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="ZeroBuffer" Version="1.2.8" />
  </ItemGroup>

</Project>

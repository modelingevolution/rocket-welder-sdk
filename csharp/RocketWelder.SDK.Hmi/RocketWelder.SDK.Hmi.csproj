<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RocketWelder.SDK.Hmi</PackageId>
    <Version>1.0.0</Version>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Description>HMI overlay abstractions for the RocketWelder SDK (IUiSink, IUi, IUiLayer) layered over BlazorBlaze vector graphics.</Description>
    <PackageTags>rocketwelder;hmi;ui;overlay;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelingEvolution.Drawing" Version="1.9.8.75" />
    <PackageReference Include="BlazorBlaze" Version="1.1.5" />
    <PackageReference Include="BlazorBlaze.Server" Version="1.1.5" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RocketWelder.SDK.Devices.Positioner.Delta</PackageId>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Description>Delta VFD-C2000 welding-positioner adapter. Software homing and positioning over Modbus TCP against the drive's built-in PLC; the drives run in speed mode because the encoders sit behind the gearboxes.</Description>
    <PackageTags>rocketwelder;devices;positioner;delta;modbus;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentModbus" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWelder.SDK.Devices.Positioner\RocketWelder.SDK.Devices.Positioner.csproj" />
  </ItemGroup>

</Project>

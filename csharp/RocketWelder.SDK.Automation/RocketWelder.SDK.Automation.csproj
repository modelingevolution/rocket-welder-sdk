<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>RocketWelder.SDK.Automation</PackageId>
    <Authors>ModelingEvolution</Authors>
    <Company>ModelingEvolution</Company>
    <Description>Plugin loader/bootstrapper for the RocketWelder SDK: discovers and activates [RocketWelderPlugin] IPlugin assemblies into the host's DeviceTypeRegistry. No event-sourcing dependency — the device kernel (aggregate/events/commands) now lives in the host. Plugins reference only RocketWelder.SDK.Automation.Abstractions.</Description>
    <PackageTags>rocketwelder;automation;plugins;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/modelingevolution/rocket-welder-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RocketWelder.SDK.Automation.Abstractions\RocketWelder.SDK.Automation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>RocketWelder.SDK.Automation.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Epic 052 cutover: the event-sourcing packages + their source generators were removed — the
         device kernel moved to the host. The plugin loader needs only logging abstractions;
         IServiceProvider (System) and the plugin/registry contracts come transitively via Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>

</Project>

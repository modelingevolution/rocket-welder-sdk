# Copy to .env and edit values before running `docker compose up`.

VIDEO_PATH=/var/data/rocket-welder/videos/sample-1080p.mp4
PLUGINS_PATH=/mnt/d/source/modelingevolution/streamer/src/out/build/Linux-WSL-Debug/app/plugins

# Stress knobs
YOLO_MODEL=yolov8x-seg.pt
CONF_THRESHOLD=0.05
INSTANCE_MULTIPLIER=4
CONTOUR_MODE=none

# Transport
BUFFER_NAME=rw-stress
SEG_SOCKET=/tmp/rw-seg.sock
